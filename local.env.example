# Copy to local.env (git-ignored) and fill in. Every setting is optional except
# OTT_TV for "./build.sh install".

# Your JioTV Go server's full playlist and guide (DRM mode on).
OTT_PLAYLIST_URL=https://jiotv.example.lan/playlist.m3u
OTT_GUIDE_URL=https://jiotv.example.lan/epg.xml.gz

# Name of the ★ list of Telugu, Hindi and English music channels.
OTT_MUSIC_LIST_NAME=Music mix

# The Android TV's IP address, for "./build.sh install" (adb debugging must be on).
OTT_TV=

# Written by build.sh on the first build. Back it up together with release.keystore.
# OTT_KEYSTORE_PASSWORD=
