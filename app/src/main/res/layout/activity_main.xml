<?xml version="1.0" encoding="utf-8"?>
<!--
  Sizes follow the mockups (1280x720 px) scaled to a 960x540 dp TV screen.
  The player is one view for both the home preview and full screen: MainActivity
  only changes its size, so switching between them never reloads the stream.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <View
        android:id="@+id/homeBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0E13" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:shutter_background_color="#000000"
        app:use_controller="false" />

    <!-- Home page: live preview, language tabs, and the selected tab's tiles. -->
    <FrameLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginHorizontal="42dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/dot" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="#EDEFF2"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#C9CFD6"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:id="@+id/heroRing"
            android:layout_width="288dp"
            android:layout_height="166dp"
            android:layout_marginStart="38dp"
            android:layout_marginTop="50dp"
            android:background="@drawable/ring" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="52dp"
            android:layout_marginTop="64dp"
            android:background="@drawable/bg_live"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="LIVE"
            android:textColor="#141413"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="158dp"
            android:layout_marginStart="346dp"
            android:layout_marginTop="54dp"
            android:layout_marginEnd="42dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hWhere"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.1"
                android:singleLine="true"
                android:textColor="#F2A93B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="#EDEFF2"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#A3ACB8"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/hProg"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="150dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="10dp"
                    android:max="100"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:progressDrawable="@drawable/progress" />
            </LinearLayout>

            <TextView
                android:id="@+id/hNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#A3ACB8"
                android:textSize="13sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OK  full screen   ·   CH + / −  change channel here"
                android:textColor="#A3ACB8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Language tabs: For you, each shown language, Settings. Filled in by MainActivity. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginHorizontal="42dp"
            android:layout_marginTop="226dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/langTabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tabHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="#A3ACB8"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="42dp"
            android:layout_marginTop="272dp"
            android:orientation="vertical" />
    </FrameLayout>

    <!-- Shown while a new channel starts, until its first picture arrives. -->
    <LinearLayout
        android:id="@+id/tuning"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#08090C"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <io.github.crkarthik11.ottplayer.LogoTile
            android:id="@+id/tTile"
            android:layout_width="78dp"
            android:layout_height="78dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.14"
            android:text="TUNING"
            android:textColor="#F2A93B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tWhere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#A3ACB8"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="18dp"
        android:paddingVertical="9dp"
        android:textColor="#EDEFF2"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Settings: which languages and genres become categories. Opaque, over everything. -->
    <LinearLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0E13"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingHorizontal="42dp"
        android:paddingTop="21dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="SETTINGS"
                    android:textColor="#A3ACB8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Choose your channels"
                    android:textColor="#EDEFF2"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#C9CFD6"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/sCats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#A3ACB8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/sLangCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/sLangTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.12"
                        android:text="LANGUAGES"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sLangPos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#A3ACB8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sLangRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <Space
                android:layout_width="18dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/sGenreCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/sGenreTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.12"
                        android:text="GENRES"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sGenrePos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#A3ACB8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sGenreRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/sPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#C9CFD6"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Up / Down move  ·  Left / Right switch list  ·  OK turn on or off  ·  Back save and return home"
            android:textColor="#A3ACB8"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="30dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="11dp"
            android:paddingVertical="6dp"
            android:text="OK / Down  Channels"
            android:textColor="#EDEFF2"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="11dp"
            android:paddingVertical="6dp"
            android:text="CH + / −  Zap   ·   ◀  Last channel   ·   Back  Home"
            android:textColor="#EDEFF2"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_pill"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="#EDEFF2"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/digits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/bg_card"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:textColor="#F2A93B"
        android:textSize="40sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Info banner, shown after a channel change or on Up / Left / Right / Info. -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="27dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="17dp"
        android:visibility="gone">

        <io.github.crkarthik11.ottplayer.LogoTile
            android:id="@+id/bTile"
            android:layout_width="63dp"
            android:layout_height="63dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F2A93B"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="10dp"
                    android:singleLine="true"
                    android:textColor="#A3ACB8"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="#EDEFF2"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/bProg"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progressDrawable="@drawable/progress" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="54dp"
            android:layout_marginStart="18dp"
            android:background="#2A303A" />

        <LinearLayout
            android:layout_width="225dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp">

            <TextView
                android:id="@+id/bNextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:textColor="#A3ACB8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="#EDEFF2"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Channel panel: category bar on top, channels and details below. -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="303dp"
        android:layout_gravity="bottom"
        android:background="#F2090B0F"
        android:orientation="vertical"
        android:paddingStart="21dp"
        android:paddingTop="13dp"
        android:paddingEnd="21dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="33dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:minWidth="88dp"
                android:orientation="vertical"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/barLang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:textColor="#F2A93B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/barLangPos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#A3ACB8"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:layout_marginEnd="10dp"
                android:background="#2A303A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="#A3ACB8"
                android:textSize="13sp" />

            <!-- Up to six genre chips of the current language, filled in by MainActivity. -->
            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textColor="#A3ACB8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/barPos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:letterSpacing="0.08"
                android:textColor="#A3ACB8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="525dp"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/chanRows"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingEnd="16dp" />

                <!-- Scroll bar for long categories: a track and a thumb at the list's right edge. -->
                <FrameLayout
                    android:id="@+id/scrollTrack"
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/scroll_track"
                    android:visibility="invisible">

                    <View
                        android:id="@+id/scrollThumb"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/scroll_thumb" />
                </FrameLayout>
            </FrameLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#1E232B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="21dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <io.github.crkarthik11.ottplayer.LogoTile
            android:id="@+id/dTile"
            android:layout_width="48dp"
            android:layout_height="48dp" />

                    <TextView
                        android:id="@+id/dName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dNowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.12"
                    android:textColor="#F2A93B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textColor="#EDEFF2"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/dProg"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="7dp"
                    android:max="100"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:progressDrawable="@drawable/progress" />

                <TextView
                    android:id="@+id/dNextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.12"
                    android:textColor="#A3ACB8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#C9CFD6"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/dHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#A3ACB8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
